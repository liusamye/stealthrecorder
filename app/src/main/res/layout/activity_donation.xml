<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#f5f5f5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/donation_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:textColor="#333333" />
    
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/donation_subtitle"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="32dp"
        android:textColor="#666666" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="如果您觉得这个应用对您有帮助，可以考虑支持一下开发工作。您的支持将帮助我继续改进这个应用。"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:gravity="center"
        android:layout_marginBottom="40dp"
        android:textColor="#666666" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/alipay_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/alipay_button"
            android:textSize="18sp"
            android:background="@drawable/button_primary"
            android:layout_marginBottom="16dp"
            android:drawableLeft="@android:drawable/ic_menu_send"
            android:drawablePadding="8dp" />

        <Button
            android:id="@+id/wechat_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/wechat_button"
            android:textSize="18sp"
            android:background="@drawable/button_primary"
            android:layout_marginBottom="16dp"
            android:drawableLeft="@android:drawable/ic_menu_share"
            android:drawablePadding="8dp" />

        <Button
            android:id="@+id/paypal_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/paypal_button"
            android:textSize="18sp"
            android:background="@drawable/button_secondary"
            android:layout_marginBottom="16dp"
            android:drawableLeft="@android:drawable/ic_menu_edit"
            android:drawablePadding="8dp" />

        <Button
            android:id="@+id/website_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/website_button"
            android:textSize="18sp"
            android:background="@drawable/button_secondary"
            android:drawableLeft="@android:drawable/ic_menu_info_details"
            android:drawablePadding="8dp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="其他支持方式：\n• 给应用好评\n• 分享给朋友\n• 反馈建议和Bug"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:textColor="#888888" />

</LinearLayout>